# Copy this file to .env (or .env.local) and fill in your Supabase project's
# values — Settings → API in the Supabase dashboard.
#
# Both must be prefixed with VITE_ to be readable by the browser-side app
# (see https://vite.dev/guide/env-and-mode.html). The anon key is safe to
# expose client-side — it's the public key, meant for this — but note that
# the schema in supabase/migrations/0001_init.sql ships with permissive RLS
# policies (anyone with this key can read/write everything), matching the
# app's previous no-login behaviour. Tighten those policies if you add auth.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
